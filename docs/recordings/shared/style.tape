# Shared look for every recording: Catppuccin Mocha colors on the background
# GitHub uses for code blocks in dark mode, so the GIFs blend in.
# Source this after a tape's own Set lines: VHS ignores Set after other commands.
Set Shell "bash"
Set Padding 24
Set TypingSpeed 45ms
Set Theme { "name": "echoascii", "black": "#45475a", "red": "#f38ba8", "green": "#a6e3a1", "yellow": "#f9e2af", "blue": "#89b4fa", "magenta": "#f5c2e7", "cyan": "#94e2d5", "white": "#bac2de", "brightBlack": "#585b70", "brightRed": "#f38ba8", "brightGreen": "#a6e3a1", "brightYellow": "#f9e2af", "brightBlue": "#89b4fa", "brightMagenta": "#f5c2e7", "brightCyan": "#94e2d5", "brightWhite": "#a6adc8", "background": "#151b23", "foreground": "#cdd6f4", "selection": "#585b70", "cursor": "#f5e0dc" }
Env COLORTERM "truecolor"
Require node

{
  "name": "echoascii",
  "version": "2.0.0",
  "description": "Turn any text into big ASCII art banners in your terminal, with 330+ bundled FIGlet fonts 😱",
  "license": "MIT",
  "dependencies": {
    "figlet": "1.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "echoascii": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && node dist/cli.js hello world"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thatsprettyfaroutman/echoascii"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "figlet",
    "banner",
    "cli",
    "terminal"
  ],
  "author": {
    "name": "Viljami Anttonen",
    "email": "viljami.anttonen@gmail.com"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^7.0.2"
  }
}
